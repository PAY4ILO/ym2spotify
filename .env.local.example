# Этот файл нужен НЕ всем.
#
# По умолчанию ключи Spotify вводятся прямо в интерфейсе на первом шаге
# и сохраняются в data/config.json. Секрет для шифрования кук генерируется сам.
#
# Переменные окружения нужны, только если ты разворачиваешь приложение своими
# средствами и хочешь задать всё заранее. Они имеют приоритет над config.json.

# Из кабинета https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Должен совпадать с Redirect URI в настройках приложения Spotify.
# Именно 127.0.0.1 — localhost Spotify не принимает.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4321/api/auth/spotify/callback

# Произвольная длинная случайная строка — ею шифруются куки с токенами.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Порт, на котором поднимается приложение.
PORT=4321
