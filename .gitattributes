# Единые переводы строк, чтобы репозиторий одинаково вёл себя на всех системах.
* text=auto eol=lf

# Скрипт запуска обязан быть с LF: с CRLF оболочка на Linux и macOS
# спотыкается на «bad interpreter» и файл просто не стартует.
*.sh text eol=lf

# Батник, наоборот, требует CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
